# Copy to bot/.env.local to run the bot from a checkout (`npm start`, which writes to the emulators).
# Never commit a real value. The deployed bot reads the same names from the project's Secret Manager:
# see bot/deploy/deploy.sh.

# Required.
DISCORD_BOT_TOKEN=
DEEPGRAM_API_KEY=

# Answering rules questions heard at the table. Leave either empty and the bot records without answering.
# TypeSafe's key, for Jev, which notices a rules question in the live transcript.
TYPESAFE_API_KEY=
# OpenAI's key, for gpt-6-luna, which answers it. On the server it is the Cloud Functions' OPENAI_API_KEY secret.
OPENAI_API_KEY=
# The rules document the answers come from. Defaults to the repository's docs/lubec/combat-rules.md.
# RULES_DOCUMENT_PATH=
