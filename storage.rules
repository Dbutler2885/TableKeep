rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function campaignMemberDoc(campaignId) {
      return firestore.get(
        /databases/(default)/documents/campaigns/$(campaignId)/members/$(request.auth.uid)
      );
    }

    function groupMemberDoc(groupId) {
      return firestore.get(
        /databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)
      );
    }

    function groupCampaignDoc(groupId, campaignId) {
      return firestore.get(
        /databases/(default)/documents/groups/$(groupId)/campaigns/$(campaignId)
      );
    }

    function isCampaignMember(campaignId) {
      return isSignedIn()
        && campaignMemberDoc(campaignId).data.status == 'active';
    }

    function isCampaignGM(campaignId) {
      return isCampaignMember(campaignId)
        && campaignMemberDoc(campaignId).data.role == 'gm';
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && groupMemberDoc(groupId).data.status == 'active';
    }

    function isGroupCampaignGM(groupId, campaignId) {
      return isGroupMember(groupId)
        && groupCampaignDoc(groupId, campaignId).data.gmUserId == request.auth.uid;
    }

    function mapDoc(campaignId, mapId) {
      return firestore.get(
        /databases/(default)/documents/campaigns/$(campaignId)/maps/$(mapId)
      );
    }

    function groupMapDoc(groupId, campaignId, mapId) {
      return firestore.get(
        /databases/(default)/documents/groups/$(groupId)/campaigns/$(campaignId)/maps/$(mapId)
      );
    }

    function characterDoc(campaignId, characterId) {
      return firestore.get(
        /databases/(default)/documents/campaigns/$(campaignId)/characters/$(characterId)
      );
    }

    function groupCharacterDoc(groupId, campaignId, characterId) {
      return firestore.get(
        /databases/(default)/documents/groups/$(groupId)/campaigns/$(campaignId)/characters/$(characterId)
      );
    }

    function canReadMapAsset(campaignId, mapId) {
      return isCampaignGM(campaignId)
        || (
          isCampaignMember(campaignId)
          && mapDoc(campaignId, mapId).data.visibleToPlayers == true
        );
    }

    function canReadGroupMapAsset(groupId, campaignId, mapId) {
      return isGroupCampaignGM(groupId, campaignId)
        || (
          isGroupMember(groupId)
          && groupMapDoc(groupId, campaignId, mapId).data.visibleToPlayers == true
        );
    }

    match /groups/{groupId}/campaigns/{campaignId}/maps/{mapId} {
      allow read: if canReadGroupMapAsset(groupId, campaignId, mapId);
      allow write: if isGroupCampaignGM(groupId, campaignId);
    }

    match /groups/{groupId}/campaigns/{campaignId}/maps/{mapId}/{allPaths=**} {
      allow read: if canReadGroupMapAsset(groupId, campaignId, mapId);
      allow write: if isGroupCampaignGM(groupId, campaignId);
    }

    match /groups/{groupId}/campaigns/{campaignId}/token-assets/{assetName} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupCampaignGM(groupId, campaignId);
    }

    match /groups/{groupId}/campaigns/{campaignId}/characters/{characterId}/token-icons/{assetName} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupCampaignGM(groupId, campaignId)
        || (
          isGroupMember(groupId)
          && groupCharacterDoc(groupId, campaignId, characterId).data.ownerUserId == request.auth.uid
        );
    }

    match /groups/{groupId}/campaigns/{campaignId}/characters/{characterId}/portraits/{assetName} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupCampaignGM(groupId, campaignId)
        || (
          isGroupMember(groupId)
          && groupCharacterDoc(groupId, campaignId, characterId).data.ownerUserId == request.auth.uid
        );
    }

    match /groups/{groupId}/campaigns/{campaignId}/npcs/{npcId}/{mediaKind}/{assetName} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupCampaignGM(groupId, campaignId)
        && (mediaKind == 'portraits' || mediaKind == 'token-icons');
    }

    match /groups/{groupId}/campaigns/{campaignId}/monsters/{monsterId}/{mediaKind}/{assetName} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupCampaignGM(groupId, campaignId)
        && (mediaKind == 'portraits' || mediaKind == 'token-icons');
    }

    match /groups/{groupId}/campaigns/{campaignId}/items/{itemId}/{mediaKind}/{assetName} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupCampaignGM(groupId, campaignId)
        && (mediaKind == 'portraits' || mediaKind == 'token-icons');
    }

    match /campaigns/{campaignId}/maps/{mapId} {
      allow read: if canReadMapAsset(campaignId, mapId);
      allow write: if isCampaignGM(campaignId);
    }

    match /campaigns/{campaignId}/maps/{mapId}/{allPaths=**} {
      allow read: if canReadMapAsset(campaignId, mapId);
      allow write: if isCampaignGM(campaignId);
    }

    match /campaigns/{campaignId}/token-assets/{assetName} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isCampaignGM(campaignId);
    }

    match /campaigns/{campaignId}/characters/{characterId}/token-icons/{assetName} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isCampaignGM(campaignId)
        || (
          isCampaignMember(campaignId)
          && characterDoc(campaignId, characterId).data.ownerUserId == request.auth.uid
        );
    }

    match /campaigns/{campaignId}/characters/{characterId}/portraits/{assetName} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isCampaignGM(campaignId)
        || (
          isCampaignMember(campaignId)
          && characterDoc(campaignId, characterId).data.ownerUserId == request.auth.uid
        );
    }

    match /campaigns/{campaignId}/npcs/{npcId}/{mediaKind}/{assetName} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isCampaignGM(campaignId)
        && (mediaKind == 'portraits' || mediaKind == 'token-icons');
    }

    match /campaigns/{campaignId}/monsters/{monsterId}/{mediaKind}/{assetName} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isCampaignGM(campaignId)
        && (mediaKind == 'portraits' || mediaKind == 'token-icons');
    }

    match /campaigns/{campaignId}/items/{itemId}/{mediaKind}/{assetName} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isCampaignGM(campaignId)
        && (mediaKind == 'portraits' || mediaKind == 'token-icons');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
