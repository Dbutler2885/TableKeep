rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // A visitor who arrived through the "try it now" link. Firebase anonymous
    // auth is the only way to get one of these tokens, and the demo entry point
    // is the only thing in the app that asks for one.
    function isAnonymousVisitor() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    // The single pristine group every demo sandbox is cloned from. The id is a
    // literal because a rules file cannot import one, and because comparing a
    // path segment to a string is free where reading a flag off the group
    // document would cost a get() on every check. It is kept in step with
    // `functions/src/demoConstants.ts` and `src/features/demo/demoConstants.ts`
    // by `src/features/demo/demoConstants.test.ts`.
    function isDemoTemplateGroup(groupId) {
      return groupId == "demo-template";
    }

    function groupMemberPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(groupMemberPath(groupId))
        && get(groupMemberPath(groupId)).data.status == "active";
    }

    function isGroupAdmin(groupId) {
      return isGroupMember(groupId)
        && get(groupMemberPath(groupId)).data.role == "admin";
    }

    // GM check for the nested group/campaign model: a group admin, or the
    // active group member whose uid matches the campaign's gmUserId.
    function isCampaignGm(groupId, campaignId) {
      return isGroupAdmin(groupId)
        || (isGroupMember(groupId)
            && get(/databases/$(database)/documents/groups/$(groupId)/campaigns/$(campaignId)).data.gmUserId == request.auth.uid);
    }

    function campaignMemberPath(campaignId) {
      return /databases/$(database)/documents/campaigns/$(campaignId)/members/$(request.auth.uid);
    }

    function isCampaignMember(campaignId) {
      return isSignedIn()
        && exists(campaignMemberPath(campaignId))
        && get(campaignMemberPath(campaignId)).data.status == "active";
    }

    function isCampaignGM(campaignId) {
      return isCampaignMember(campaignId)
        && get(campaignMemberPath(campaignId)).data.role == "gm";
    }

    function isCharacterOwner() {
      return isSignedIn() && request.auth.uid == resource.data.ownerUserId;
    }

    function onlyChanges(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function isValidUsername(username) {
      return username is string && username.matches('^[A-Za-z0-9_!@#$%^&*()]{7}$');
    }

    function hasUsername(data) {
      return data.keys().hasAny(['username']);
    }

    match /usernames/{username} {
      allow read: if isSignedIn();

      // Handles are a global uniqueness index; an anonymous visitor is shown a
      // local stand-in name instead of burning (or squatting) a real one.
      allow create: if isSignedIn()
        && !isAnonymousVisitor()
        && isValidUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && (!hasUsername(request.resource.data) || isValidUsername(request.resource.data.username));
      allow update: if isSelf(userId)
        && (!hasUsername(request.resource.data) || isValidUsername(request.resource.data.username))
        && (!hasUsername(resource.data) || request.resource.data.username == resource.data.username);
      allow delete: if isSelf(userId);

      match /campaignMemberships/{campaignId} {
        allow read: if isSelf(userId);

        // Users can self-manage their own user-scoped membership index as player.
        allow create, update: if (
          isSelf(userId)
          && request.resource.data.userId == userId
          && request.resource.data.role == "player"
        ) || (
          isSelf(userId)
          && request.resource.data.userId == userId
          && request.resource.data.role == "gm"
          && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.createdBy == request.auth.uid
        ) || isCampaignGM(campaignId);

        allow delete: if isSelf(userId) || isCampaignGM(campaignId);
      }
    }

    match /groups/{groupId} {
      // Membership, not merely being signed in. The app used to listen to the
      // whole `groups` collection and filter client-side, which meant any
      // signed-in account could enumerate every group's name; `useGroupAccess`
      // now resolves a user's groups from their own membership documents, so
      // nothing needs the wider read. The demo template is the one exception,
      // and it holds a public sample campaign.
      allow read: if isGroupMember(groupId)
        || (isSignedIn() && isDemoTemplateGroup(groupId));
      // Demo visitors get exactly the one group the clone function makes them.
      allow create: if isSignedIn()
        && !isAnonymousVisitor()
        && request.resource.data.createdBy == request.auth.uid;
      // Any active group member may switch which campaign is active (e.g.
      // promoting their own draft). Restricted to the active-campaign pointer
      // fields so members can't rename the group or alter other metadata.
      allow update: if isGroupAdmin(groupId)
        || (isGroupMember(groupId)
            && onlyChanges(['activeCampaignId', 'currentCampaignId', 'updatedAt']));
      allow delete: if isGroupAdmin(groupId);

      match /members/{userId} {
        allow read: if isGroupMember(groupId) || isSelf(userId);
        allow create: if isGroupAdmin(groupId) || (
          isSelf(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == "active"
          && request.resource.data.role == "admin"
          && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
        ) || (
          isSelf(userId)
          && !isAnonymousVisitor()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == "active"
          && request.resource.data.role == "member"
          && request.resource.data.invitedVia is string
          && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.invitedVia)).data.groupId == groupId
          && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.invitedVia)).data.revoked == false
          && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.invitedVia)).data.expiresAt > request.time
          && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.invitedVia)).data.redeemedBy == null
        );
        allow update: if isGroupAdmin(groupId) || (
          isSelf(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == "active"
          && request.resource.data.role == resource.data.role
        );
        allow delete: if isGroupAdmin(groupId) || isSelf(userId);
      }

      match /invites/{inviteId} {
        allow read: if isGroupMember(groupId);
        allow create, update, delete: if isGroupMember(groupId);
      }

      match /campaigns/{campaignId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.createdBy == request.auth.uid;
        // Group admins and the campaign's own GM have full edit/delete. Any
        // active member may additionally flip only a campaign's status (and
        // updatedAt), which is needed to demote the previously-active campaign
        // when promoting their own draft to active.
        allow update: if isGroupAdmin(groupId)
          || (isGroupMember(groupId) && resource.data.gmUserId == request.auth.uid)
          || (isGroupMember(groupId) && onlyChanges(['status', 'updatedAt']));
        allow delete: if isGroupAdmin(groupId)
          || (isGroupMember(groupId) && resource.data.gmUserId == request.auth.uid);

        // Per-user campaign UI scratch (currentCharacterId,
        // lastSeenCliffhangerNoteId). Owner-only, except the campaign GM / group
        // admin may list and delete members' scratch when tearing down a
        // campaign (delete needs read to enumerate the collection first).
        match /userState/{userId} {
          allow read, write: if isSelf(userId) && isGroupMember(groupId);
          allow read, delete: if isCampaignGm(groupId, campaignId);
        }

        match /characters/{characterId} {
          allow read: if isGroupMember(groupId);
          allow create: if isGroupMember(groupId)
            && request.resource.data.ownerUserId == request.auth.uid;
          allow update: if isCampaignGm(groupId, campaignId) || isCharacterOwner();
          allow delete: if isCampaignGm(groupId, campaignId) || isCharacterOwner();
        }

        match /maps/{mapId} {
          allow read: if isGroupMember(groupId);
          allow write: if isCampaignGm(groupId, campaignId);

          match /tokens/{tokenId} {
            allow read: if isGroupMember(groupId);
            allow write: if isCampaignGm(groupId, campaignId);
          }

          match /annotations/{annotationId} {
            allow read: if isCampaignGm(groupId, campaignId) || (
              isGroupMember(groupId)
              && resource.data.kind == "player"
              && resource.data.hidden != true
            );
            allow write: if isCampaignGm(groupId, campaignId);
          }

          match /fogChunks/{chunkId} {
            allow read: if isGroupMember(groupId);
            allow write: if isCampaignGm(groupId, campaignId);
          }
        }

        match /tokenAssets/{assetId} {
          allow read: if isGroupMember(groupId);
          allow write: if isCampaignGm(groupId, campaignId);
        }

        match /monsters/{monsterId} {
          allow read: if isGroupMember(groupId);
          allow write: if isCampaignGm(groupId, campaignId);
        }

        match /npcs/{npcId} {
          allow read: if isCampaignGm(groupId, campaignId)
            || (isGroupMember(groupId) && resource.data.visibleToPlayers == true);
          allow create, delete: if isCampaignGm(groupId, campaignId);
          allow update: if isCampaignGm(groupId, campaignId) || (
            isGroupMember(groupId)
            && resource.data.visibleToPlayers == true
            && request.resource.data.visibleToPlayers == true
            && request.resource.data.name == resource.data.name
            && request.resource.data.title == resource.data.title
            && request.resource.data.playerDescription == resource.data.playerDescription
            && onlyChanges([
              'playerNotes', 'tags', 'sortOrder',
              'portraitPath', 'portraitFocusX', 'portraitFocusY', 'tokenIcon',
              'updatedAt'
            ])
          );
        }

        match /npcPrivate/{npcId} {
          allow read, write: if isCampaignGm(groupId, campaignId);
        }

        match /itemApprovals/{approvalId} {
          allow read: if isGroupMember(groupId);
          allow create: if isGroupMember(groupId)
            && request.resource.data.requestedByUserId == request.auth.uid
            && request.resource.data.status == 'pending';
          allow update: if isCampaignGm(groupId, campaignId);
          allow delete: if isGroupMember(groupId);
        }

        match /items/{itemId} {
          allow read: if isGroupMember(groupId);
          allow create: if isCampaignGm(groupId, campaignId)
            || (isGroupMember(groupId) && request.resource.data.status == 'dropped');
          allow update, delete: if isCampaignGm(groupId, campaignId);
        }

        match /tables/{tableId} {
          allow read, write: if isCampaignGm(groupId, campaignId);

          match /history/{entryId} {
            allow read, write: if isCampaignGm(groupId, campaignId);
          }
        }

        match /pendingTransfers/{transferId} {
          allow read: if isGroupMember(groupId);
          allow create: if isGroupMember(groupId)
            && request.resource.data.fromUserId == request.auth.uid
            && get(/databases/$(database)/documents/groups/$(groupId)/campaigns/$(campaignId)/characters/$(request.resource.data.fromCharacterId)).data.ownerUserId == request.auth.uid
            && request.resource.data.itemKind != 'gold'
            && request.resource.data.keys().hasAll([
              'id', 'itemSnapshot', 'itemId', 'itemKind', 'itemName',
              'fromCharacterId', 'fromCharacterName', 'fromUserId',
              'toCharacterId', 'toCharacterName', 'toUserId', 'createdAt'
            ]);
          allow update: if false;
          allow delete: if request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId
            || isCampaignGm(groupId, campaignId);
        }

        match /images/{imageId} {
          allow read: if isCampaignGm(groupId, campaignId)
            || (isGroupMember(groupId) && resource.data.revealed == true);
          allow write: if isCampaignGm(groupId, campaignId);
        }

        match /referenceDocs/{docId} {
          allow read: if isCampaignGm(groupId, campaignId)
            || (isGroupMember(groupId) && resource.data.visibleToPlayers == true);
          allow write: if isCampaignGm(groupId, campaignId);
        }

        match /sessionSummaries/{summaryId} {
          allow read: if isGroupMember(groupId);
          allow write: if isCampaignGm(groupId, campaignId);
        }

        match /sharedNotes/{noteId} {
          allow read: if isGroupMember(groupId);
          allow write: if isCampaignGm(groupId, campaignId);
        }
      }
    }

    // The demo template, read-only, to anyone signed in - including an anonymous
    // "try it now" visitor. There is no matching write grant anywhere: the
    // template group has no member documents, so `isGroupMember` and
    // `isCampaignGm` are false for every account, and the seeding script writes
    // it through the admin SDK, which does not consult these rules. That is what
    // makes the template unwritable by construction rather than by an exception.
    match /groups/{groupId}/{demoTemplateDocument=**} {
      allow read: if isSignedIn() && isDemoTemplateGroup(groupId);
    }

    // A user's own membership documents, wherever they live. `useGroupAccess`
    // needs a collection-group query to find which groups a user belongs to
    // without reading every group in the database, and a collection-group query
    // is only matched by a rule with a recursive prefix.
    //
    // The test is on the document's `userId` field rather than on the {userId}
    // path segment, because a `list` is evaluated against the query rather than
    // against one document: the id wildcard is unbound there, and comparing it
    // to `request.auth.uid` raises a null-value error instead of returning
    // false. Matching the field means the grant is satisfied exactly by a query
    // that filters `userId == request.auth.uid`, which is the only query the app
    // issues - so this still exposes nothing beyond a user's own rows.
    match /{demoMembershipPath=**}/members/{userId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /campaigns/{campaignId} {
      // The legacy flat tree predates the group model and holds one real
      // campaign. An anonymous demo visitor has no business in it.
      allow read: if isCampaignMember(campaignId) || (
        isSignedIn() && !isAnonymousVisitor() && resource.data.status == "active"
      );
      allow create: if isSignedIn()
        && !isAnonymousVisitor()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isCampaignGM(campaignId);

      match /members/{userId} {
        allow read: if isCampaignMember(campaignId) || isSelf(userId);

        // Bootstrap: campaign creator can self-add as GM for a brand new campaign.
        // Self-join path: any signed-in user can add self as player to active campaign.
        allow create: if (
          isCampaignGM(campaignId)
          || (
            isSelf(userId)
            && !isAnonymousVisitor()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == "active"
            && (
              request.resource.data.role == "player"
              || (
                request.resource.data.role == "gm"
                && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.createdBy == request.auth.uid
              )
            )
          )
        );

        allow update: if isCampaignGM(campaignId) || (
          isSelf(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role == "player"
          && request.resource.data.status == "active"
        ) || (
          isSelf(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role == "gm"
          && request.resource.data.status == "active"
          && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.createdBy == request.auth.uid
        );
        allow delete: if isCampaignGM(campaignId);
      }

      match /characters/{characterId} {
        allow read: if isCampaignMember(campaignId);
        allow create: if isCampaignGM(campaignId) || (
          isSignedIn() && request.resource.data.ownerUserId == request.auth.uid
        );
        allow update: if isCampaignGM(campaignId) || isCharacterOwner();
        allow delete: if isCampaignGM(campaignId) || isCharacterOwner();
      }

      match /maps/{mapId} {
        allow read: if isCampaignMember(campaignId);
        allow write: if isCampaignGM(campaignId);

        match /tokens/{tokenId} {
          allow read: if isCampaignMember(campaignId);
          allow write: if isCampaignGM(campaignId);
        }

        match /annotations/{annotationId} {
          allow read: if isCampaignGM(campaignId) || (
            isCampaignMember(campaignId)
            && resource.data.kind == "player"
            && resource.data.hidden != true
          );
          allow write: if isCampaignGM(campaignId);
        }

        match /fogChunks/{chunkId} {
          allow read: if isCampaignMember(campaignId);
          allow write: if isCampaignGM(campaignId);
        }
      }

      match /tokenAssets/{assetId} {
        allow read: if isCampaignMember(campaignId);
        allow write: if isCampaignGM(campaignId);
      }

      match /monsters/{monsterId} {
        allow read: if isCampaignMember(campaignId);
        allow write: if isCampaignGM(campaignId);
      }

      match /npcs/{npcId} {
        allow read: if isCampaignGM(campaignId)
          || (isCampaignMember(campaignId) && resource.data.visibleToPlayers == true);
        allow create, delete: if isCampaignGM(campaignId);
        allow update: if isCampaignGM(campaignId) || (
          isCampaignMember(campaignId)
          && resource.data.visibleToPlayers == true
          && request.resource.data.visibleToPlayers == true
          && request.resource.data.name == resource.data.name
          && request.resource.data.title == resource.data.title
          && request.resource.data.playerDescription == resource.data.playerDescription
          && onlyChanges([
            'playerNotes', 'tags', 'sortOrder',
            'portraitPath', 'portraitFocusX', 'portraitFocusY', 'tokenIcon',
            'updatedAt'
          ])
        );
      }

      match /npcPrivate/{npcId} {
        allow read, write: if isCampaignGM(campaignId);
      }

      match /itemApprovals/{approvalId} {
        allow read: if isCampaignMember(campaignId);
        allow create: if isCampaignMember(campaignId)
          && request.resource.data.requestedByUserId == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isCampaignGM(campaignId);
        allow delete: if isCampaignMember(campaignId);
      }

      match /items/{itemId} {
        allow read: if isCampaignMember(campaignId);
        allow create: if isCampaignGM(campaignId)
          || (isCampaignMember(campaignId) && request.resource.data.status == 'dropped');
        allow update, delete: if isCampaignGM(campaignId);
      }

      match /tables/{tableId} {
        allow read, write: if isCampaignGM(campaignId);

        match /history/{entryId} {
          allow read, write: if isCampaignGM(campaignId);
        }
      }

      match /pendingTransfers/{transferId} {
        allow read: if isCampaignMember(campaignId);
        allow create: if isCampaignMember(campaignId)
          && request.resource.data.fromUserId == request.auth.uid
          && get(/databases/$(database)/documents/campaigns/$(campaignId)/characters/$(request.resource.data.fromCharacterId)).data.ownerUserId == request.auth.uid
          && request.resource.data.itemKind != 'gold'
          && request.resource.data.keys().hasAll([
            'id', 'itemSnapshot', 'itemId', 'itemKind', 'itemName',
            'fromCharacterId', 'fromCharacterName', 'fromUserId',
            'toCharacterId', 'toCharacterName', 'toUserId', 'createdAt'
          ]);
        allow update: if false;
        allow delete: if request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId
          || isCampaignGM(campaignId);
      }

      match /images/{imageId} {
        allow read: if isCampaignGM(campaignId) || (isCampaignMember(campaignId) && resource.data.revealed == true);
        allow write: if isCampaignGM(campaignId);
      }

      match /referenceDocs/{docId} {
        allow read: if isCampaignGM(campaignId) || (isCampaignMember(campaignId) && resource.data.visibleToPlayers == true);
        allow write: if isCampaignGM(campaignId);
      }

      match /sessionSummaries/{summaryId} {
        allow read: if isCampaignMember(campaignId);
        allow write: if isCampaignGM(campaignId);
      }

      match /sharedNotes/{noteId} {
        allow read: if isCampaignMember(campaignId);
        allow write: if isCampaignGM(campaignId);
      }
    }

    // Top-level invite codes. Read is open to any signed-in user (security
    // depends on token entropy — invitees fetch by token to see the accept
    // screen). Create/delete restricted to group admins; updates allow either
    // an admin (revoke) or the redeeming user (mark redeemed once).
    match /inviteCodes/{token} {
      // Anonymous visitors are out of the invite flow in both directions: they
      // cannot look a token up, cannot redeem one into a real user's group, and
      // cannot mint one out of the demo sandbox they are admin of (which would
      // outlive the sandbox, since invite codes are top-level documents the
      // expiry sweep does not touch).
      allow read: if isSignedIn() && !isAnonymousVisitor();

      allow create: if isSignedIn()
        && !isAnonymousVisitor()
        && isGroupAdmin(request.resource.data.groupId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.redeemedBy == null
        && request.resource.data.revoked == false;

      allow update: if isSignedIn() && !isAnonymousVisitor() && (
        // Admin can revoke or otherwise edit
        isGroupAdmin(resource.data.groupId)
        // Or the redeemer can mark it redeemed exactly once
        || (
          resource.data.redeemedBy == null
          && resource.data.revoked == false
          && resource.data.expiresAt > request.time
          && request.resource.data.redeemedBy == request.auth.uid
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.revoked == resource.data.revoked
        )
      );

      allow delete: if isSignedIn() && !isAnonymousVisitor() && isGroupAdmin(resource.data.groupId);
    }
  }
}
