# Demo-mode Firebase configuration.
#
# These are not credentials. They are placeholder values that let the Firebase
# Web SDK initialise while every call is redirected to the local Firebase
# emulators, which never contact a real Google project. Nothing here is secret
# and nothing here needs to be filled in.
#
# The demo scripts (`npm run demo`, `npm run demo:author`) read this file and
# inject these values into the Vite dev server they start, so a clean clone
# needs no `.env.local` and no Firebase project. The normal `npm run dev` path
# does not read this file; it starts empty emulators and routes its SDKs there.
#
# The project id must stay in sync with `.firebaserc`: the Storage emulator
# resolves the `firestore.get()` calls in `storage.rules` against the project
# it was started with.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=homeboyshouse-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=homeboyshouse-dev
VITE_FIREBASE_STORAGE_BUCKET=homeboyshouse-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_FIREBASE_EMULATORS=true

# The two seeded demo accounts.
#
# They live here rather than in `scripts/demo/config.mjs` so that both sides of
# the demo can read one definition: the Node seeding scripts import this file
# through `scripts/demo/config.mjs`, and the sign-in screen reads the same
# values as Vite env vars because `scripts/demo/run.mjs` injects them into the
# demo dev server. `npm run dev` and `npm run build` never load this file, so a
# production bundle folds every `import.meta.env.VITE_DEMO_*` reference to
# `undefined` and offers no demo seats at all.
#
# These are not secrets. The accounts exist only inside a local emulator.
VITE_DEMO_GM_EMAIL=demo-gm@tablekeep.test
VITE_DEMO_GM_PASSWORD=tablekeep-demo
VITE_DEMO_PLAYER_EMAIL=demo-player@tablekeep.test
VITE_DEMO_PLAYER_PASSWORD=tablekeep-demo
