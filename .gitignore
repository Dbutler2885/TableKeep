# Firebase
.firebase/
# Generated by `npm run demo:sandbox`: firebase.json with the sandbox port
# block swapped in. Generated rather than committed so the rules paths and the
# functions source keep one definition.
firebase.sandbox.json
# Generated by `npm run rehearse:floors`: firestore.rules with every character
# schema floor raised, and firebase.json pointing the emulators at it.
firestore.rehearsal.rules
firebase.rehearsal.json
# emulator-data/ is deliberately NOT ignored: it holds the committed demo
# snapshot that `npm run demo` imports. Do not add it here.

