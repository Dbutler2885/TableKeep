{
  "name": "table-keep",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only firestore,storage \"vitest run --config vitest.emulator.config.ts\"",
    "test:browser-smoke": "firebase emulators:exec --only auth,firestore,storage \"node scripts/browser-smoke.mjs\"",
    "preview": "vite preview",
    "ose:monsters:fetch-raw": "node scripts/fetch-ose-monsters-raw.mjs",
    "ose:treasure:fetch": "node scripts/fetch-ose-treasure-types.mjs",
    "ose:cleric:fetch": "node scripts/fetch-ose-cleric-spells.mjs",
    "ose:magic-user:fetch": "node scripts/fetch-ose-magic-user-spells.mjs",
    "ose:magic-user:import": "node scripts/import-ose-magic-user-spells.mjs",
    "firebase:login": "firebase login",
    "emulators": "firebase emulators:start",
    "emulators:import": "firebase emulators:start --import ./emulator-data --export-on-exit",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "demo": "node scripts/demo/run.mjs --mode=visitor",
    "demo:author": "node scripts/demo/run.mjs --mode=author",
    "demo:save": "firebase emulators:export ./emulator-data --force",
    "demo:seed": "node scripts/demo/seed-accounts.mjs",
    "demo:size": "node scripts/demo/check-snapshot-size.mjs",
    "demo:seed-template": "firebase emulators:exec --only firestore,storage --import ./emulator-data \"node scripts/demo/seed-template.mjs\"",
    "demo:sandbox": "node scripts/demo/run-sandbox.mjs",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions"
  },
  "dependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify/react": "^6.0.2",
    "firebase": "^12.9.0",
    "konva": "^10.3.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.5",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.8.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "puppeteer": "^25.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
